{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.selfhost",
    "watchPatterns": [
      "src/**",
      "scripts/**",
      "migrations/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "vite.config.ts",
      "wrangler.jsonc",
      "docker-entrypoint.sh",
      "Dockerfile.selfhost"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 600,
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 10,
    "overlapSeconds": "0",
    "drainingSeconds": "30"
  }
}
