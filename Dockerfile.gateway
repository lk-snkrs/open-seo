FROM node:22.18.0-slim AS builder

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.30.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY gateway/package.json gateway/tsconfig.json gateway/
RUN pnpm install --frozen-lockfile --filter @lk/open-seo-gateway...

COPY gateway gateway
RUN pnpm --filter @lk/open-seo-gateway build \
  && pnpm --filter @lk/open-seo-gateway deploy --legacy --prod /prod/gateway

FROM node:22.18.0-slim AS runner

ENV NODE_ENV=production

WORKDIR /app

COPY --from=builder --chown=node:node /prod/gateway ./

USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/healthz').then(function(r){process.exit(r.ok?0:1)}).catch(function(){process.exit(1)})"

CMD ["node", "dist/main.js"]
