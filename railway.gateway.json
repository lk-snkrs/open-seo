{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.gateway",
    "watchPatterns": [
      "gateway/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "Dockerfile.gateway"
    ]
  },
  "deploy": {
    "multiRegionConfig": {
      "us-east4-eqdc4a": {
        "numReplicas": 1
      }
    },
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 10,
    "overlapSeconds": 30,
    "drainingSeconds": 30
  }
}
